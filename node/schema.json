{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mcp-rendezvous operator policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tools", "feedback"],
  "properties": {
    "version": {"const": 1},
    "tools": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["actions"],
        "properties": {"actions": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"}}}
      }
    },
    "feedback": {
      "type": "object", "additionalProperties": false,
      "required": ["default", "on", "routes", "client_instruction"],
      "properties": {
        "default": {"type": "boolean"},
        "on": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["success", "failure", "cancelled"]}},
        "client_instruction": {"const": "End this turn immediately. Do not poll."},
        "routes": {
          "type": "object", "minProperties": 1, "additionalProperties": false,
          "properties": {
            "herdr": {
              "type": "object", "additionalProperties": false,
              "required": ["adapter", "executable", "args"],
              "properties": {
                "adapter": {"const": "herdr"},
                "executable": {"type": "string", "pattern": "^/[^\u0000-\u001f\u007f{}]+$", "maxLength": 4096},
                "args": {"const": ["agent", "prompt", "{target}", "finished"]}
              }
            },
            "webhook": {
              "type": "object", "additionalProperties": false,
              "required": ["adapter", "method", "body"],
              "properties": {
                "adapter": {"const": "webhook"}, "method": {"const": "POST"}, "body": {"const": {}},
                "allowed_hosts": {"type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^(\\*\\.)?[a-z0-9][a-z0-9.-]*$"}}
              }
            }
          }
        }
      }
    }
  }
}
